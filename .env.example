# ==============================================================================
# SMART AGRI MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# SIH 2026 — Problem Statement 26033
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Never commit actual secret keys or credentials to version control.
# 3. Client components CANNOT access variables without the NEXT_PUBLIC_ prefix.
# 4. Server-only secrets MUST NEVER have the NEXT_PUBLIC_ prefix.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# API Versioning & Routing
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE (Public)
# ------------------------------------------------------------------------------
# Used by the Firebase Web Client SDK in the browser for authentication only.
NEXT_PUBLIC_FIREBASE_API_KEY=your-client-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Feature Flag: Set to "true" to use client mock services during UI development
NEXT_PUBLIC_USE_MOCK_SERVICES=true

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK (Strictly Server-Only)
# ------------------------------------------------------------------------------
# Service Account credentials for verifying ID tokens and accessing Firestore.
# NEVER expose these with NEXT_PUBLIC_ prefix.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: When pasting private key, retain newline escapes ("\n") or surround with double quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: Path to service account JSON file (alternative to inline env vars)
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json

# ------------------------------------------------------------------------------
# 3. LOCAL FIREBASE EMULATOR SUITE (Development / Testing)
# ------------------------------------------------------------------------------
# Uncomment when running against local Firebase Emulators:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Server-Side Signed Uploads)
# ------------------------------------------------------------------------------
# Cloudinary credentials for generating server signatures and asset management.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ------------------------------------------------------------------------------
# 5. RAZORPAY TEST MODE (Payment Gateway & Escrow)
# ------------------------------------------------------------------------------
# Strictly Server-Only credentials. NEVER prefix with NEXT_PUBLIC_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

