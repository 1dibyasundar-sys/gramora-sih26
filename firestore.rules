rules_version = '2';

/**
 * SMART AGRI MARKETPLACE — FIRESTORE SECURITY RULES
 * SIH 2026 Problem Statement: 26033
 * 
 * Strict Server-Authoritative Data Access Policy:
 * All Firestore reads, writes, and queries must be routed exclusively
 * through the server-side Next.js /api/v1 handlers via the Firebase Admin SDK.
 * Direct client-side SDK reads and writes are strictly disallowed.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
